# Supabase credentials — copy this file to `.env` and fill in your project values.
# Never commit `.env`. The anon key is public-safe (protected by Row Level Security);
# the service role key must NEVER be exposed through a VITE_ variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
